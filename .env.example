# Copy to .env at the project root. Never commit credentials.
AI_MODE=live
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DASHSCOPE_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
# Local SQLite portability mode; Compose sets PostgreSQL instead.
DATABASE_URL=sqlite:///.local/kiwi.db
REQUEST_TIMEOUT=45
CALL_TIMEOUT=18
MAX_RETRIES=1
MIN_SIMILARITY=0.40
SEMANTIC_ONLY_THRESHOLD=0.65
# Bounded candidate refill and account feedback; no new model for feedback writes.
RECOMMENDATION_SCAN_LIMIT=500
RECOMMENDATION_SCAN_BATCH=50
FEEDBACK_STATE_LIMIT=1000
FEEDBACK_WRITE_LIMIT=60
LANGSMITH_TRACING=false
# Bounded serial refresh. Categories are selected on the home page.
CRAWL_PAGES_PER_SOURCE=5
CRAWL_MAX_PAGES=25
CRAWL_MAX_WORKS=500
CRAWL_INTERVAL=0.5
CRAWL_TIMEOUT=300
INDEX_TIMEOUT=600
REFRESH_TIMEOUT=900
# Browser account/session settings. Secure=false is accepted only for loopback HTTP.
AUTH_COOKIE_SECURE=false
AUTH_PASSWORD_USER_LIMIT=5
AUTH_PASSWORD_IP_LIMIT=20
AUTH_SESSION_SECONDS=604800
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8080,http://localhost:8080
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_FAILURE_LIMIT=5
AUTH_REGISTER_LIMIT=10
AUTH_HASH_CONCURRENCY=2
AUTH_LIMITER_CAPACITY=10000
# Public preference refinement, per connection IP per minute.
PREFERENCE_REFINE_IP_LIMIT=20
# Offline preview import; install external FFmpeg/ffprobe or set full executable paths.
MEDIA_ROOT=.local/media/previews
MEDIA_DELIVERY_MODE=app
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
PREVIEW_SOURCE_MAX_BYTES=209715200
PREVIEW_OUTPUT_MAX_BYTES=20971520
PREVIEW_PROBE_TIMEOUT=10
PREVIEW_PROCESS_TIMEOUT=120
# First-episode previews are prepared automatically after startup and catalogue updates.
PREVIEW_AUTO_ENABLED=true
PREVIEW_WORKERS=2
# Windows: msedge (installed Edge); Linux/container: chromium (playwright install chromium).
PREVIEW_BROWSER_CHANNEL=msedge
PREVIEW_NODE_PATH=node
# Optional existing Playwright module path. Empty uses project node_modules/playwright.
PREVIEW_PLAYWRIGHT_MODULE=
PREVIEW_FETCH_TIMEOUT=60
PREVIEW_RETRY_SECONDS=60
PREVIEW_ATTEMPTS=3
